# RabbitMQ 本地开发环境变量模板
# 使用：cp .env.example .env（.env 已被根 .gitignore 忽略，不会提交）
#
# 重要：RABBITMQ_DEFAULT_USER / RABBITMQ_DEFAULT_PASS 只在 ./data 首次初始化时生效。
# 改完如果发现登录还是旧账号，执行 docker compose down && rm -rf ./data && docker compose up -d。

# 镜像版本（compose 会拼成 rabbitmq:<版本>-management，必须带 -management 才有管理界面）
RABBITMQ_VERSION=4.4.1

# 默认账号（仅本地开发，端口只绑 127.0.0.1）
RABBITMQ_DEFAULT_USER=admin
RABBITMQ_DEFAULT_PASS=admin123

# 宿主机端口，和本机已装的 RabbitMQ 冲突时改这里
RABBITMQ_AMQP_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# 内存告警阈值不在 .env 里配：RabbitMQ 4.4 起相关环境变量已废弃（设置后容器拒绝启动），
# 统一改 conf/rabbitmq.conf 里的 vm_memory_high_watermark.relative
