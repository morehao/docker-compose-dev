# RustFS 本地开发环境变量示例：复制为 .env 并按需修改（.env 已被 .gitignore 忽略）
#
# 注意：RUSTFS_API_PORT / RUSTFS_CONSOLE_PORT 已废弃 —— 容器走 host 网络，
# 端口在 docker-compose.yml 里用 RUSTFS_ADDRESS / RUSTFS_CONSOLE_ADDRESS 直接指定。

# 存储根凭证（控制台 / S3 API / 策略运维脚本共用）
RUSTFS_ACCESS_KEY=rustfsadmin
RUSTFS_SECRET_KEY=rustfsadmin

# Ark IAM 提供方地址（ark-iam gateway 的 origin，不带路径）。
# 容器走 host 网络，故 localhost 即宿主机；discovery 与出站白名单都由它派生。
ARK_IAM_ORIGIN=http://localhost:8100

# rustfs_console 的 client_secret（明文）。
# 来源：ark-iam 平台控制台 → OAuth 客户端 rustfs_console → 密钥管理 → 创建密钥（明文只显示一次）。
RUSTFS_OIDC_CLIENT_SECRET=
