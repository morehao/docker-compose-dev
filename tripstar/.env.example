# TripStar 环境变量模板
# 使用：cp .env.example .env 后填入真实值（.env 已被 .gitignore 忽略，不会提交）

# ========== LLM（OpenAI 兼容接口）==========
# 任意兼容 OpenAI Chat Completions 的服务均可
LLM_API_KEY=your_llm_api_key
LLM_BASE_URL=https://your-openai-compatible-endpoint/v1
LLM_MODEL_ID=your_model
LLM_TIMEOUT=600

# ========== 高德地图 ==========
# 后端「Web服务」类型 Key：地理编码、POI、天气、路线（REST / MCP）
VITE_AMAP_WEB_KEY=your_amap_web_service_key
# 前端「Web端(JS API)」Key：地图渲染（构建期注入，改后需重新构建）
VITE_AMAP_WEB_JS_KEY=your_amap_web_js_key
# 前端 JS API 安全密钥 JSCode（构建期注入 index.html，改后需重新构建）
VITE_AMAP_SECURITY_JS_CODE=your_amap_security_js_code

# ========== 小红书（可选，景点数据来源）==========
# 浏览器登录小红书后，打开 F12 → Network → 任意请求 → Request Headers 中的 cookie
# 最少需包含 a1 与 web_session 两个字段；也可直接粘贴整段 Cookie（兼容 JSON 导出格式）
# 格式示例：a1=xxxx; web_session=xxxx
XHS_COOKIE=

# ========== Google Maps（可选）==========
GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_PROXY=

# ========== 用户偏好记忆模块（可选）==========
ENABLE_USER_MEMORY=false
MEMORY_THRESHOLD=2.0
MIN_INIT_WEIGHT=4.0
MEMORY_DECAY_FACTOR=0.97
MEMORY_MAX_RECALL=10
MEMORY_MAX_SINGLE_CONTENT=120
MEMORY_USE_SQLITE=false

# ========== 部署参数 ==========
# 源码目录（docker-compose.yml 的构建上下文）
TRIPSTAR_SRC=/root/project/TripStar
# 镜像名与标签
TRIPSTAR_IMAGE=tripstar:latest
# 对外暴露端口（容器内固定 7860）
TRIPSTAR_PORT=7860
# 日志级别
LOG_LEVEL=INFO
